(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self' ws: wss:;"
	}
}

(app_routes) {
	import security_headers
	encode zstd gzip

	# Block scanner probes and sensitive paths at proxy level
	@blocked {
		path /.env* /proc/* *.php *.sql /.git*
	}
	respond @blocked 404

	# Requests wait out the few-second backend swap instead of failing with 502.
	handle_path /api/* {
		reverse_proxy backend:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
			health_uri /health
			health_interval 5s
		}
	}

	handle /ws/* {
		reverse_proxy backend:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy frontend:5173
	}
}

http://finance.jizihome.com, https://finance.jizihome.com, jizifin.duckdns.org {
	import app_routes
}

localhost, http://localhost, http://127.0.0.1 {
	tls internal
	import app_routes
}
