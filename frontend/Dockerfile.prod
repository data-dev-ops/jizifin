# Multi-stage production build for Svelte / Vite frontend.
# Needs the `backend` build context (compose: additional_contexts) for jizifin-wasm.

# Stage 1: CSV parser to WebAssembly (wasm-bindgen CLI pinned to the locked crate)
FROM rust:1-bookworm AS wasm
WORKDIR /src
COPY --from=backend Cargo.toml Cargo.lock clippy.toml ./
COPY --from=backend crates ./crates
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    rustup target add wasm32-unknown-unknown && \
    cargo install wasm-bindgen-cli --locked --version "$(sed -n '/^name = "wasm-bindgen"$/{n;s/version = "\(.*\)"/\1/p;}' Cargo.lock)"
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    cargo build --release --target wasm32-unknown-unknown -p jizifin-wasm && \
    wasm-bindgen --target web --out-dir /out target/wasm32-unknown-unknown/release/jizifin_wasm.wasm

# Exportable package (make wasm writes it to src/lib/wasm for the dev server)
FROM scratch AS wasm-pkg
COPY --from=wasm /out /

# Stage 2: Build static assets
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package manifests
COPY package*.json ./

# Install all dependencies (including devDependencies for build tooling)
RUN --mount=type=cache,target=/root/.npm \
    npm install --include=optional --no-audit --no-fund

# Copy build configs and source files
COPY postcss.config.js tailwind.config.js svelte.config.js vite.config.js index.html ./
COPY src/ ./src/
COPY --from=wasm /out ./src/lib/wasm/

# Compile production bundle to /app/dist
RUN npm run build

# Stage 3: Hardened Alpine Nginx production server
FROM nginx:alpine AS production

# Remove default nginx configs
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 5173

# Healthcheck using wget
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:5173 || exit 1

CMD ["nginx", "-g", "daemon off;"]
