# Multi-stage production build for Svelte / Vite frontend

# Stage 1: Build static assets
FROM node:22-alpine AS builder

WORKDIR /app

# Copy package manifests
COPY package*.json ./

# Install all dependencies (including devDependencies for build tooling)
RUN --mount=type=cache,target=/root/.npm \
    npm install --include=optional --no-audit --no-fund

# Copy build configs and source files
COPY postcss.config.js tailwind.config.js svelte.config.js vite.config.js index.html ./
COPY src/ ./src/

# Compile production bundle to /app/dist
RUN npm run build

# Stage 2: Hardened Alpine Nginx production server
FROM nginx:alpine AS production

# Remove default nginx configs
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom Nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 5173

# Healthcheck using wget
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O- http://127.0.0.1:5173 || exit 1

CMD ["nginx", "-g", "daemon off;"]
